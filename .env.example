# go-hyperliquid examples — environment template.
# Copy to .env (git-ignored). NEVER commit real keys. Use TESTNET credentials.
#
# Hyperliquid has no API key/secret. The three variables follow the desk's
# credential convention (<EXCHANGE>_API_KEY / _SECRET_KEY / _PASSPHRASE):
#   API_KEY     master account address (0x + 40 hex)
#   SECRET_KEY  private key of the API wallet (agent) approved by that account
#   PASSPHRASE  optional sub-account / vault address to trade on behalf of
# API wallets are created on the "API" page of the Hyperliquid app (mainnet:
# https://app.hyperliquid.xyz/API, per the official Python SDK README); use the
# same page of the TESTNET app (app.hyperliquid-testnet.xyz) for these examples.

HYPERLIQUID_PERPETUALS_TESTNET_API_KEY=
HYPERLIQUID_PERPETUALS_TESTNET_SECRET_KEY=
HYPERLIQUID_PERPETUALS_TESTNET_PASSPHRASE=

# Safety gate of the order-sending examples (testnet only).
HYPERLIQUID_ALLOW_LIVE=0

# Optional knobs.
HYPERLIQUID_COIN=BTC
HYPERLIQUID_NOTIONAL=12
HYPERLIQUID_USE_WS_POST=0
